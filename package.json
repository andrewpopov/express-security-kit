{
  "name": "@andrewpopov/express-security-kit",
  "version": "1.0.0",
  "description": "Dependency-light Express security library. Owns the machinery (helmet preset, rate limiter); consuming services inject all policy.",
  "author": "Andrew Popov",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./redis-store": {
      "types": "./dist/rate-limit/redis-store.d.ts",
      "default": "./dist/rate-limit/redis-store.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:pack": "node scripts/verify-pack.mjs"
  },
  "peerDependencies": {
    "express": ">=4",
    "helmet": ">=7"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "express": "^4.19.2",
    "fast-check": "^4.8.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
