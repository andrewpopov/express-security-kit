{
  "name": "@andrewpopov/express-security-kit",
  "version": "1.6.0",
  "description": "Dependency-light Express security library. Owns the machinery (helmet preset, rate limiter); consuming services inject all policy.",
  "author": "Andrew Popov",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/andrewpopov/express-security-kit.git" },
  "bugs": { "url": "https://github.com/andrewpopov/express-security-kit/issues" },
  "homepage": "https://github.com/andrewpopov/express-security-kit#readme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./redis-store": {
      "types": "./dist/core/rate-limit/redis-store.d.ts",
      "default": "./dist/core/rate-limit/redis-store.js"
    },
    "./nonce-redis": {
      "types": "./dist/core/signing/nonce-redis.d.ts",
      "default": "./dist/core/signing/nonce-redis.js"
    },
    "./cors": {
      "types": "./dist/core/cors/policy.d.ts",
      "default": "./dist/core/cors/policy.js"
    },
    "./express/cors": {
      "types": "./dist/express/cors/corsOptions.d.ts",
      "default": "./dist/express/cors/corsOptions.js"
    },
    "./webhook": {
      "types": "./dist/core/webhook/verify.d.ts",
      "default": "./dist/core/webhook/verify.js"
    },
    "./express/webhook": {
      "types": "./dist/express/webhook/createWebhookVerifier.d.ts",
      "default": "./dist/express/webhook/createWebhookVerifier.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json && npm run check:core-agnostic",
    "check:core-agnostic": "node scripts/check-core-agnostic.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:pack": "node scripts/verify-pack.mjs",
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "audit:development": "npm audit --audit-level=high",
    "verify": "npm run typecheck && npm test && npm run build && npm run verify:pack && npm run audit:runtime && npm run audit:development"
  },
  "peerDependencies": {
    "cors": ">=2",
    "express": ">=4",
    "helmet": ">=7"
  },
  "peerDependenciesMeta": {
    "cors": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "cors": "^2.8.6",
    "express": "^4.19.2",
    "fast-check": "^4.8.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
